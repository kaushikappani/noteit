# ─── Backend ──────────────────────────────────────────────────────────────────
# Origin of the Noteit backend the tools call. Origin only — `/notesv2` is a
# React route, not an API prefix.
#   local dev : http://localhost:5000
#   production: https://noteit-prod2.onrender.com
# Leave unset when mounted inside the Noteit app itself; it then loops back to
# http://127.0.0.1:$PORT.
NOTEIT_API_URL=http://localhost:5000

# ─── Transport ────────────────────────────────────────────────────────────────
# stdio (default) — run as a subprocess of the MCP client (Claude Code, inspector)
# http            — standalone HTTP server: streamable HTTP at $MCP_PATH,
#                   legacy SSE at $MCP_PATH/sse
# Overridable per-run with `node src/index.js --http`.
MCP_TRANSPORT=stdio

# Port for MCP_TRANSPORT=http (standalone only; falls back to PORT, then 5100)
MCP_PORT=5100

# Path MCP is served under, in standalone mode and when mounted into the Noteit app
MCP_PATH=/mcp

# Reply to POSTs with plain JSON instead of an SSE stream. Default true — it
# survives compressing/buffering proxies. Set false for spec-preferred streaming.
MCP_JSON_RESPONSE=true

# Idle HTTP sessions are closed after this long. Sessions are a cache in front
# of the grant store now, not the login itself — a client presenting its grant
# key re-authenticates on whatever session it lands on — so this bounds memory
# rather than how long someone stays signed in. Default 30 days.
MCP_SESSION_TTL_MS=2592000000

# Hard cap on concurrent sessions, since a 30-day TTL means the sweeper no
# longer bounds them. Sessions that never logged in are given up first, so an
# anonymous flood cannot evict a signed-in user. Default 500.
MCP_MAX_SESSIONS=500

# CORS origin for standalone http mode
MCP_ALLOWED_ORIGIN=*

# ─── Origin allowlist (mounted mode, i.e. /mcp on the Noteit app) ─────────────
# Extra browser origins allowed to drive /mcp, comma-separated. Requests with no
# Origin (every non-browser MCP client), browser-extension origins, and the
# server's own origin are always allowed; other web pages are refused, so a site
# the user happens to have open cannot sit there opening sessions. Set to "*" to
# go back to allowing everything. Add your dev frontend here when it runs on a
# different port than the API.
# MCP_ALLOWED_ORIGINS=http://localhost:3000

# ─── Durable logins ───────────────────────────────────────────────────────────
# Nothing to configure: mounted into the Noteit app, grants are stored in the
# app's Redis and survive restarts. Running standalone (index.js), they are held
# in memory instead and are lost when the process stops — fine for stdio and
# local development, not for a deployment people log into.

# ─── Noteit app only (root .env) ──────────────────────────────────────────────
# Set to "false" to stop app.js from mounting /mcp on the deployed server.
# MCP_HTTP_ENABLED=true
